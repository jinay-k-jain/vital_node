# ============================================================
# VitalNode Backend - Environment Configuration Template
# Copy to .env and fill in real values.
# NEVER commit .env to source control.
# ============================================================

# --- Application ---
APP_ENV=development          # development | production
APP_NAME=VitalNode
APP_VERSION=1.0.0
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
DEMO_MODE=true               # true enables /api/v1/demo/* endpoints

# --- Database ---
# PostgreSQL connection URL
DATABASE_URL=postgresql+asyncpg://vitalnode_user:CHANGE_ME@localhost:5432/vitalnode_db
# Sync URL used only for Alembic migrations
DATABASE_SYNC_URL=postgresql://vitalnode_user:CHANGE_ME@localhost:5432/vitalnode_db

# --- Security ---
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480   # 8 hours for clinical shift

# --- CORS ---
FRONTEND_URL=http://localhost:5173

# --- Speech-to-Text ---
# Supported: mock | openai_whisper | google_speech | azure_speech
SPEECH_PROVIDER=mock
SPEECH_API_KEY=CHANGE_ME_or_leave_empty_for_mock

# --- ML Model ---
ML_ENGINE=xgboost
MODEL_PATH=app/ml/vitalnode_production.json

# --- Gemini API (used by core_engine.py for NLP extraction) ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- Hospital Configuration ---
HOSPITAL_NAME=City Emergency Hospital
HOSPITAL_DEPARTMENT=Emergency Department
HOSPITAL_LOCATION=Mumbai, Maharashtra

# --- Reassessment Intervals (minutes) ---
REASSESSMENT_CRITICAL_MIN=5
REASSESSMENT_HIGH_MIN=15
REASSESSMENT_MODERATE_MIN=30
REASSESSMENT_LOW_MIN=60

# --- Surge ---
SURGE_PATIENT_COUNT=12

# --- Feature Flags ---
ENABLE_DEVICE_SIMULATION=true
ENABLE_AUDIT_LOG=true
